{
  "name": "echoes-of-the-hearth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node tools/dev/stack.mjs",
    "start:dev": "node tools/dev/stack.mjs --dev",
    "stack:servers": "node tools/dev/stack.mjs --dev --no-client",
    "start:legacy": "node tools/dev/stack.mjs --legacy --dev",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "control": "node control/index.js",
    "game": "cd gameserver && go run ./cmd/hearthd",
    "server": "node server/index.js",
    "server:dev": "set DEV=1&& node server/index.js",
    "defs": "node tools/defs/gen-defs.mjs",
    "defs:check": "node tools/defs/gen-defs.mjs --check",
    "test:go": "node gameserver/test-go.mjs",
    "test:control": "node control/test.mjs",
    "test:legacy": "node test.mjs",
    "test:parity": "node tools/worldparity/compare.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "alea": "^1.0.1",
    "phaser": "^3.80.1",
    "simplex-noise": "^4.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
